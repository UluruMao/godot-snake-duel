func set_text(v: String) -> void:
	text = v.to_upper()
	_relayout()


func set_pixel(v: int) -> void:
	pixel = max(1, v)
	_relayout()


func set_color(v: Color) -> void:
	color = v
	queue_redraw()


func _relayout() -> void:
	if not is_inside_tree():
		custom_minimum_size = _measure()
		return
	custom_minimum_size = _measure()
	size = custom_minimum_size
	queue_redraw()


func _measure() -> Vector2:
	var w: float = max(1, text.length()) * 6.0 * pixel - pixel
	return Vector2(w, 7.0 * pixel)


func _draw() -> void:
	var x := 0.0
	for ch in text:
		var g: Array = GLYPHS.get(ch, GLYPHS[" "])
		for row in 7:
			var bits: String = g[row]
			for col_i in 5:
				if bits.substr(col_i, 1) == "1":
					draw_rect(Rect2(x + col_i * pixel, row * pixel, pixel, pixel), color)
		x += 6.0 * pixel
