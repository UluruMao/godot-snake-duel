# Generated Godot cache and local editor state
.godot/
.idea/
.vscode/

# Local operating-system files
.DS_Store
Thumbs.db

# Native runtime DLLs are deliverables; intermediate build files are not.
/native/.sconsign*
/native/bin/*.exp
/native/bin/*.lib
/native/bin/*.pdb
/native/bin/*.ilk
/native/bin/*.obj
/native/bin/~*

# Default project-icon import sidecar is regenerated by Godot.
/icon.svg.import
